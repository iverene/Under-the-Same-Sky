PORT=5000
# Supabase Postgres connection (service_role / postgres direct - bypasses RLS, backend needs full access)
# Get from: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
