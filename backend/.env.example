# Copy to .env: cp .env.example .env  (Windows: copy .env.example .env)
# Then fill in real values. Never commit .env.

# --- Server ---
# Must match the frontend fallback in frontend/src/api.js (http://localhost:5000/api/messages)
PORT=5000

# --- CORS ---
# Comma-separated frontend origins allowed to call the API.
# Include every local Vite port you use (Vite bumps 5173 -> 5174 when 5173 is busy).
# Default in backend/server.js covers both; same-origin needs no CORS anyway.
# Example for production:
# CORS_ORIGIN=https://under-the-same-sky.app,https://www.under-the-same-sky.app
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Database (Supabase Postgres) ---
# Get from: Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
