PORT=5000
# Comma-separated frontend origins allowed to call the API (default: http://localhost:5173)
# Example: CORS_ORIGIN=https://under-the-same-sky.app,https://www.under-the-same-sky.app
CORS_ORIGIN=http://localhost:5173
# Supabase Postgres connection (service_role / postgres direct - bypasses RLS, backend needs full access)
# Get from: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
